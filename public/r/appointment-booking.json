      "clinical-watch-foreground": "oklch(0.88 0.13 85)",
      "clinical-abnormal": "oklch(0.72 0.18 50)",
      "clinical-abnormal-foreground": "oklch(0.84 0.11 55)",
      "clinical-critical": "oklch(0.66 0.21 25)",
      "clinical-critical-foreground": "oklch(0.81 0.11 20)",
      "clinical-info": "oklch(0.72 0.13 230)",
      "clinical-info-foreground": "oklch(0.84 0.08 225)"
    }
  },
  "categories": [
    "blocks"
  ],
  "type": "registry:block"
}