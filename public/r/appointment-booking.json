      "clinical-abnormal-foreground": "oklch(0.52 0.16 40)",
      "clinical-critical": "oklch(0.6 0.22 27)",
      "clinical-critical-foreground": "oklch(0.5 0.19 27)",
      "clinical-info": "oklch(0.64 0.13 235)",
      "clinical-info-foreground": "oklch(0.48 0.12 240)"
    },
