/**
 * Generates:
 *  - registry.json            → consumed by `shadcn build` (outputs public/r/*.json)
 *  - __registry__/demos.tsx   → demo component map used by the docs site
 *
 * Run with: node scripts/build-registry.mts
 */
import { readdirSync, readFileSync, writeFileSync, mkdirSync } from "node:fs"
import path from "node:path"

import { registryItems } from "../registry/items.ts"
import { siteConfig, registryUrl } from "../lib/site.ts"
import {
  accentColors,
  clinicalCssVars,
  clinicalPalettes,
  defaultThemeConfig,
  getThemeVars,
  type ThemeModeVars,
} from "../lib/themes.ts"

const root = path.resolve(import.meta.dirname, "..")

// Items whose source uses `clinical-*` classes ship the default clinical tokens,
// so `shadcn add` writes them into the consumer's globals.css.
const usesClinicalTokens = (files: { path: string }[]) =>
  files.some((file) => /--clinical-|clinical-(normal|watch|abnormal|critical|info)/.test(readFileSync(path.join(root, file.path), "utf8")))

const pick = (vars: ThemeModeVars, keys: (key: string) => boolean): ThemeModeVars => ({
  light: Object.fromEntries(Object.entries(vars.light).filter(([key]) => keys(key))),
  dark: Object.fromEntries(Object.entries(vars.dark).filter(([key]) => keys(key))),
})

const isAccentKey = (key: string) => /^(primary|ring|chart|sidebar-(primary|ring))/.test(key)

// Installable themes: one per accent colour (primary, ring, charts) and one per
// clinical palette. Surfaces (background, border…) are left to the consumer's base colour.
const themeItems = [
  ...accentColors.map((accent) => ({
    name: `theme-${accent.name}`,
    type: "registry:theme",
    title: `${accent.label} theme`,
    description: `${accent.label} primary, ring and chart colours.`,
    categories: ["themes"],
    cssVars: pick(getThemeVars({ ...defaultThemeConfig, accent: accent.name }), isAccentKey),
  })),
  ...clinicalPalettes.map((palette) => ({
    name: `clinical-${palette.name}`,
    type: "registry:theme",
    title: `${palette.label} clinical colours`,
    description: palette.description,
    categories: ["themes"],
    cssVars: pick(getThemeVars({ ...defaultThemeConfig, clinical: palette.name }), (key) => key.startsWith("clinical-")),
  })),
]

const registry = {
  $schema: "https://ui.shadcn.com/schema/registry.json",
  name: siteConfig.name,
  homepage: siteConfig.url,
  items: registryItems.map((item) => ({
    name: item.name,
    type: item.type,
    title: item.title,
    description: item.description,
    categories: [item.category.toLowerCase().replace(/\s+/g, "-")],
    ...(item.dependencies?.length ? { dependencies: item.dependencies } : {}),
    ...(item.registryDependencies?.length
      ? {
          registryDependencies: item.registryDependencies.map((dep) =>
            dep.startsWith("medicn:") ? registryUrl(dep.slice("medicn:".length)) : dep
          ),
        }
      : {}),
    files: item.files,
    ...(usesClinicalTokens(item.files) ? { cssVars: clinicalCssVars } : {}),
  })),
}
registry.items.push(...(themeItems as never[]))

writeFileSync(path.join(root, "registry.json"), JSON.stringify(registry, null, 2) + "\n")

const demoDir = path.join(root, "components/demos")
const demos = readdirSync(demoDir)
  .filter((file) => file.endsWith(".tsx"))
  .map((file) => file.replace(/\.tsx$/, ""))
  .sort()

const toIdentifier = (name: string) =>
  name.replace(/(^|-)([a-z0-9])/g, (_, __, c: string) => c.toUpperCase())

mkdirSync(path.join(root, "__registry__"), { recursive: true })
writeFileSync(
  path.join(root, "__registry__/demos.tsx"),
  `// Auto-generated by scripts/build-registry.mts. Do not edit.
import type * as React from "react"

${demos.map((d) => `import ${toIdentifier(d)} from "@/components/demos/${d}"`).join("\n")}

export const demos: Record<string, React.ComponentType> = {
${demos.map((d) => `  "${d}": ${toIdentifier(d)},`).join("\n")}
}
`
)

const blocks = registryItems.filter((item) => item.type === "registry:block").map((item) => item.name)
writeFileSync(
  path.join(root, "__registry__/blocks.tsx"),
  `// Auto-generated by scripts/build-registry.mts. Do not edit.
import type * as React from "react"

${blocks.map((b) => `import ${toIdentifier(b)}Block from "@/components/blocks/${b}/page"`).join("\n")}

export const blocks: Record<string, React.ComponentType> = {
${blocks.map((b) => `  "${b}": ${toIdentifier(b)}Block,`).join("\n")}
}
`
)

console.log(`registry.json: ${registry.items.length} items · demos: ${demos.length}`)
